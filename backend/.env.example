# PostgreSQL connection string from Neon (or any Postgres provider)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret for signing JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# URL of the deployed frontend (used for CORS). Defaults to http://localhost:5173 if not set.
FRONTEND_URL=https://your-frontend-domain.com

# Demo control panel (/demo/* routes: wipe bookings, reset slots, seed data,
# impersonate, and email-config, which reroutes outgoing mail for EVERY school).
# Off unless exactly "true" (case-insensitive) -- when off, every /demo route
# returns 404 as if it didn't exist. Leave off in production unless you are
# actively running a demo.
DEMO_ENABLED=false

# Comma-separated admin emails allowed to use /demo when DEMO_ENABLED=true.
# Matched case-insensitively, whitespace trimmed. Being a school admin is not
# enough; any admin not listed here gets 403. Empty = nobody.
DEMO_ADMIN_EMAILS=
